---
---
<section id="skills" class="container">
  <span class="label">// Competenze</span>
  <h2 style="margin-bottom: 3rem;">Stack<br/>Tecnico</h2>
  <div class="grid-2">
    <div>
      <h3 style="font-family: var(--font-mono); font-size: 1rem; text-transform: uppercase; margin-bottom: 1rem;">BI & Visualization</h3>
      <ul class="skills-list" style="margin-bottom: 2rem;">
        <li>Power BI</li>
        <li>DAX</li>
        <li>Power Query</li>
        <li>Tableau</li>
        <li>Excel Avanzato</li>
      </ul>
      <h3 style="font-family: var(--font-mono); font-size: 1rem; text-transform: uppercase; margin-bottom: 1rem;">Data Engineering</h3>
      <ul class="skills-list">
        <li>SQL Server</li>
        <li>Oracle PL/SQL</li>
        <li>Talend</li>
        <li>DataStage</li>
        <li>Databricks</li>
      </ul>
    </div>
    <div>
      <h3 style="font-family: var(--font-mono); font-size: 1rem; text-transform: uppercase; margin-bottom: 1rem;">Programming</h3>
      <ul class="skills-list" style="margin-bottom: 2rem;">
        <li>Python</li>
        <li>Pandas</li>
        <li>NumPy</li>
        <li>Scikit-learn</li>
        <li>SQL</li>
        <li>R</li>
      </ul>
      <h3 style="font-family: var(--font-mono); font-size: 1rem; text-transform: uppercase; margin-bottom: 1rem;">Cloud & Infra</h3>
      <ul class="skills-list">
        <li>Google Cloud Platform</li>
        <li>Azure</li>
        <li>ElasticSearch</li>
        <li>Git / GitHub</li>
      </ul>
    </div>
  </div>
</section>
