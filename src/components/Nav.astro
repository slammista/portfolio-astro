---
const links = [
  { href: "#about", label: "Chi sono" },
  { href: "#experience", label: "Esperienza" },
  { href: "#studio", label: "Studio" },
  { href: "#projects", label: "Progetti" },
  { href: "#contact", label: "Contatti" },
];
---
<nav class="nav" aria-label="Navigazione principale">
  <a class="nav-mark" href="#top" aria-label="Torna in cima">MA<span aria-hidden="true">.</span></a>
  <ul class="nav-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    position: fixed;
    top: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 52px;
    padding: 0 1.25rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(10, 10, 12, 0.72);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    max-width: calc(100% - 2rem);
  }

  .nav-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    color: var(--fg);
    border-bottom: none;
    flex-shrink: 0;
  }
  .nav-mark span { color: var(--accent); }
  .nav-mark:hover { color: var(--accent); }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    border-bottom: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--fg);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav {
      background: var(--bg-elevated);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* Below the pill's comfortable width, keep only the mark and drop the link row */
  @media (max-width: 680px) {
    .nav-links { display: none; }
    .nav { gap: 0; padding: 0 1.1rem; }
  }
</style>
