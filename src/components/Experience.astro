---
const roles = [
  {
    period: "Mag 2025, Presente",
    title: "Data Analyst & Developer",
    org: "Proxima Group, Toyota / MediaPoint 95",
    points: [
      "Dashboard Power BI per KPI di vendita: riduzione tempi di reporting del 20%",
      "Analisi dei requisiti con stakeholder, traduzione in specifiche tecniche",
      "Ottimizzazione query su SQL Server ed ElasticSearch",
    ],
  },
  {
    period: "Set 2024, Apr 2025",
    title: "Jr. Software & ETL Developer",
    org: "Origin Srl, Vodafone / NTT Data",
    points: [
      "Sviluppo processi ETL con Talend e stored procedure Oracle PL/SQL",
      "Sistemi di monitoraggio pipeline: 99% uptime in produzione",
      "Gestione SDLC completo da UAT a produzione in contesti Agile",
    ],
  },
  {
    period: "Gen 2024, Ago 2024",
    title: "IT Consultant",
    org: "Comit Srl, RAI / SIAE",
    points: [
      "Service management via Jira e ServiceNow: -15% tempi di risoluzione",
      "Supervisione infrastrutture IT critiche e supporto utenti interni",
    ],
  },
];
---
<section id="experience" class="container">
  <h2 data-reveal>Percorso professionale</h2>

  <div class="timeline">
    {roles.map((role) => (
      <div class="timeline-item" data-reveal>
        <div class="timeline-marker" aria-hidden="true"></div>
        <div class="timeline-meta">{role.period}</div>
        <h3>{role.title}</h3>
        <p class="timeline-org">{role.org}</p>
        <ul class="timeline-points">
          {role.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .timeline {
    margin-top: 2rem;
  }

  .timeline-item {
    position: relative;
    border-left: 1px solid var(--border-strong);
    padding: 0 0 3.5rem 2rem;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -6px;
    top: 0.4rem;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 59, 48, 0.16);
  }

  .timeline-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.6rem;
  }

  .timeline-org {
    color: var(--muted);
    margin-bottom: 1.1rem;
  }

  .timeline-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .timeline-points li {
    padding-left: 1.1rem;
    position: relative;
    max-width: 62ch;
  }
  .timeline-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 5px;
    height: 5px;
    background: var(--accent);
  }
</style>
